k8s/**/secret.yaml
k8s/**/*.secret.yaml
*.pem
*.key
*.crt

# Binaires telecharges a la racine (kubectl s'installe dans /usr/local/bin)
/kubectl
/minikube

# Builds
dist/
build/
.vite/
.react-router/

# Cache et sorties d'outils
.cache/
coverage/
*.tsbuildinfo

# Données locales (volumes Docker montés dans le projet)
data/
mongo-data/
minio-data/

# Éditeurs et OS
.vscode/
.idea/
*.swp
.DS_Store
