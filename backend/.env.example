# Copier en .env pour le dev local : cp .env.example .env
# Valeurs pointant vers MongoDB et MinIO lancés via docker compose depuis la racine.

PORT=3001

MONGO_URL=mongodb://photo:changeme@localhost:27017/photogallery?authSource=admin

MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=photos
