# Copier en .env puis adapter : cp .env.example .env
# Le .env n'est jamais versionné.

# --- MongoDB ---
MONGO_USER=photo
MONGO_PASSWORD=changeme
MONGO_DB=photogallery
MONGO_PORT=27017

# --- MinIO ---
# MINIO_SECRET_KEY doit faire au moins 8 caractères.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=photos
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Port exposé sur l'hôte ---
# Seul le reverse proxy est publié : le front et l'API passent par lui.
PROXY_PORT=8080

# Interface web MongoDB (profil `outils`, pas démarrée par défaut)
MONGO_EXPRESS_PORT=8081

# --- Administration ---
# Un seul compte. L'empreinte se génère avec : cd backend && npm run hash -- "mon mot de passe"
ADMIN_USER=nroi
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:a_remplacer:a_remplacer
# Secret de signature des cookies de session, à tirer au hasard :
#   node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
# Le changer invalide toutes les sessions ouvertes.
SESSION_SECRET=a_remplacer
# Cookie `secure` : à laisser faux tant que l'origine est en HTTP.
COOKIE_SECURE=false
